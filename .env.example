# Deploy (Windows deploy.ps1)
IT_PORTAL_DEPLOY_HOST=your-server.example.com
IT_PORTAL_DEPLOY_USER=your-ssh-user
IT_PORTAL_DEPLOY_PASSWORD=your-ssh-password
IT_PORTAL_REMOTE_DIR=/opt/it-portal

# Server install (install.sh)
IT_PORTAL_APP_DIR=/opt/it-portal
IT_PORTAL_SERVER_IP=your.server.ip.or.hostname

# API runtime
IT_PORTAL_API_PORT=4501
IT_PORTAL_DB_PATH=/opt/it-portal/data/it-portal.db
